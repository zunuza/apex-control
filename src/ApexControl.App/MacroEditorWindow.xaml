<Window x:Class="ApexControl.App.MacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro editor" Icon="Assets/app.ico" Width="980" Height="780" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp" Deactivated="OnDeactivated"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- everything about the macro (DataContext = the macros view model) -->
        <Grid Grid.Row="0" DataContext="{Binding Macros}" Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding EditorTitle}" Style="{StaticResource H2}" FontSize="19" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>

            <!-- record bar -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartRecordingCommand}" Padding="18,8"
                                Visibility="{Binding IsNotRecording, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#DC2626" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Record"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding StopRecordingCommand}" Padding="18,8"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" Fill="#111113" Margin="0,0,9,0" VerticalAlignment="Center" RadiusX="2" RadiusY="2"/>
                                <TextBlock Text="Stop"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding RecordingNote}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- add blocks / set all waits -->
            <DockPanel Grid.Row="2" Margin="0,0,0,6" IsEnabled="{Binding IsNotRecording}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="All waits" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox Text="{Binding BulkWaitText, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,6,8" Padding="6,3"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="{StaticResource MutedBrush}"/>
                    <Button Content="Set" Style="{StaticResource SecondaryButton}" Padding="12,3" Margin="0,0,0,8" Command="{Binding SetAllWaitsCommand}"/>
                </StackPanel>
                <WrapPanel>
                    <Button Content="+ Key down" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,8" Command="{Binding AddDownCommand}"/>
                    <Button Content="+ Key up" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,8" Command="{Binding AddUpCommand}"/>
                    <Button Content="+ Wait" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,8" Command="{Binding AddWaitCommand}"/>
                    <Button Content="+ Key tap" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,8" Command="{Binding AddTapCommand}"
                            ToolTip="Adds Key down, Wait, Key up in one go"/>
                    <Button Content="Clear all" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,0,8" Command="{Binding ClearEventsCommand}"/>
                </WrapPanel>
            </DockPanel>

            <!-- the timeline -->
            <ScrollViewer x:Name="TimelineScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsNotRecording}">
                <ItemsControl ItemsSource="{Binding Events}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,0,5">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Button Content="&#x2191;" Style="{StaticResource SecondaryButton}" Padding="8,1" ToolTip="Move earlier"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"/>
                                        <Button Content="&#x2193;" Style="{StaticResource SecondaryButton}" Padding="8,1" Margin="4,0,0,0" ToolTip="Move later"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"/>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Padding="8,1" Margin="4,0,0,0"
                                                Command="{Binding DataContext.RemoveEventCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number}" Width="26" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.EventKindChoices, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                  SelectedItem="{Binding KindName, Mode=TwoWay}" Width="116" Padding="8,3"/>
                                        <ComboBox ItemsSource="{Binding DataContext.KeyChoices, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                  SelectedItem="{Binding Key, Mode=TwoWay}" Width="140" Margin="8,0,0,0" Padding="8,3"
                                                  Visibility="{Binding IsKey, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding IsWait, Converter={StaticResource BoolToVis}}">
                                            <TextBox Text="{Binding MsText, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="6,3"/>
                                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12"/>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="18" Margin="0,3,0,0" FontSize="12"/>
            </StackPanel>

            <DockPanel Grid.Row="5" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Remove this macro..." Style="{StaticResource SecondaryButton}" Command="{Binding RemoveCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="{Binding ApplyText}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" HorizontalAlignment="Right"/>
                <TextBlock Text="Saving asks you to confirm and shows exactly what will be written." Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>

        <!-- status of the write (DataContext = the main view model) -->
        <Border Grid.Row="1" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,9">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" FontSize="12"/>
                <ProgressBar Height="4" Margin="0,7,0,0" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="{Binding ProgressMax, Mode=OneWay}"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}" BorderThickness="0"
                             IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
