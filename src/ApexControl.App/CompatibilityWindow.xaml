<Window x:Class="ApexControl.App.CompatibilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility check" Icon="Assets/app.ico" Width="960" Height="850" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" DataContext="{Binding Compatibility}" Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Will this work on my keyboard?" Style="{StaticResource H2}" FontSize="19"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           Text="Apex Control was built and tested on the Apex Pro TKL (USB 1038:1614) only. Below is what Windows reports for each SteelSeries device on this PC, compared with the TKL - nothing is sent to any keyboard for that. You can optionally read the profile from a keyboard that has the same command interface to check its format; that reads Config 1 the way GG does and writes nothing. Send the report to the developer if you want a model looked at."/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" FontSize="12.5" Padding="0"/>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="{Binding ReadHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SaveNote}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Optional: export for the developer" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6"
                                   Text="Creates one .zip on this PC with the report and Config 1's key layout. Nothing is uploaded; you decide whether to send it. By default your profile's name, your macros and which keys have macros are left out."/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Show folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Create export" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"/>
                            <CheckBox Content="Include my macros and profile name (raw read, plus the second data block)" IsChecked="{Binding ExportIncludePersonal, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ExportHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding ExportNote}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy report" Style="{StaticResource SecondaryButton}" Click="OnCopy" Margin="0,0,8,0"/>
                    <Button Content="Save report" Style="{StaticResource SecondaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Scan again" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0"/>
                    <Button Content="Read this keyboard's profile (read-only)..." Style="{StaticResource PrimaryButton}" Command="{Binding ReadCommand}"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,9">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" FontSize="12"/>
                <ProgressBar Height="4" Margin="0,7,0,0" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="{Binding ProgressMax, Mode=OneWay}"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}" BorderThickness="0"
                             IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
