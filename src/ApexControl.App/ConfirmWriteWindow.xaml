<Window x:Class="ApexControl.App.ConfirmWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Icon="Assets/app.ico" Width="820" Height="600" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"/>

        <Border x:Name="DetailsCard" Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DetailsText" FontSize="12" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" IsDefault="True" IsCancel="True" Margin="0,0,10,0" Click="OnCancel"/>
            <Button x:Name="WriteButton" Content="Write to keyboard" Style="{StaticResource PrimaryButton}" Click="OnWrite"/>
        </StackPanel>
    </Grid>
</Window>
