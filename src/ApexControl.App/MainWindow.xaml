<Window x:Class="ApexControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ApexControl.App"
        Title="Apex Control" Icon="Assets/app.ico" Width="1380" Height="832" ResizeMode="CanMinimize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Border Grid.Row="0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="12" Padding="10,4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{Binding KeyboardPillBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding KeyboardPillText}" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="10,4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{Binding GgPillBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GgPillText}" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Compatibility..." Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="0,0,8,0" Click="OnCompatibilityClick"
                            ToolTip="Will this work on another SteelSeries keyboard? A read-only report."/>
                    <Button Content="Re-check" Style="{StaticResource SecondaryButton}" Padding="12,4" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Apex Control" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Margin="14,2,0,0" VerticalAlignment="Center" FontSize="12">
                        <Hyperlink NavigateUri="https://ko-fi.com/zunuza" RequestNavigate="OnLinkNavigate" Style="{StaticResource SoftLink}">buy me a coffee!</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- GG-running banner -->
        <Border Grid.Row="1" Background="{StaticResource WarnBackBrush}" Padding="20,10"
                Visibility="{Binding GgRunning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding GgBannerText}" TextWrapping="Wrap" Foreground="{StaticResource WarnTextBrush}"/>
        </Border>

        <!-- body: profiles on the left, tabs on the right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ON-BOARD PROFILES" Style="{StaticResource SectionLabel}" Margin="20,20,20,10"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                        <TextBlock Text="BACKUP" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                        <Button Content="Save backup" Style="{StaticResource PrimaryButton}" Command="{Binding BackupAllCommand}" Margin="0,0,0,8"
                                ToolTip="Reads all 5 profiles from the keyboard and saves a copy in the backups folder. Read-only."/>
                        <Button Content="Restore..." Style="{StaticResource SecondaryButton}" Click="OnRestoreClick"
                                ToolTip="Put a saved copy of a profile back on the keyboard."/>
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="2,16,0,0"
                                  ToolTip="Starts Apex Control hidden in the tray when you sign in to Windows."/>
                        <TextBlock Text="{Binding AutoStartHint}" FontSize="12" Margin="2,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutoStartHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="14,0,14,8" Padding="14,0,6,0" MinHeight="46" CornerRadius="10" BorderThickness="1" Cursor="Hand"
                                                MouseLeftButtonDown="OnProfileMouseDown" ToolTip="Double-click to switch the keyboard to this profile">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource RaisedBrush}"/></Trigger>
                                                        <DataTrigger Binding="{Binding SwitchedHere}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource ActiveProfileBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentEdgeBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel VerticalAlignment="Center">
                                                <Button DockPanel.Dock="Right" Content="&#x270E;" Style="{StaticResource GhostButton}" ToolTip="Rename this profile"
                                                        Command="{Binding BeginRenameCommand}" Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}"/>
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" Padding="8,4"
                                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                             IsVisibleChanged="OnRenameBoxVisibleChanged" KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus"/>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="20,10,20,0"
                                       Text="Double-click a profile to switch to it. The Macros and SOCD tabs edit the profile you last switched to (Config 1 when the app starts); Actuation can be sent live (Send to keyboard) or also written into the profile (Save to Config N...). Use the pencil to rename it (names are kept in this app only). The keyboard can't say which profile is active, so the highlighted one only shows what this app last set."/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="22,12,22,0">
            <TabControl x:Name="Tabs">

                <!-- MACROS -->
                <TabItem Header="Macros">
                    <Grid DataContext="{Binding Macros}" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button DockPanel.Dock="Left" Content="Load from keyboard" Style="{StaticResource PrimaryButton}" Padding="14,6" Command="{Binding LoadCommand}"/>
                            <TextBlock Text="{Binding LoadedText}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,12" HorizontalAlignment="Left">
                            <local:KeyboardView Rows="{Binding KeyboardRows}" KeyCommand="{Binding SelectKeyCommand}"/>
                        </Border>

                        <StackPanel Grid.Row="2" VerticalAlignment="Top">
                            <!-- the picked key -->
                            <Border Style="{StaticResource Card}" Padding="18,14">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="{Binding EditButtonText}" Style="{StaticResource PrimaryButton}" Padding="16,7" Command="{Binding OpenEditorCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Remove this macro..." Style="{StaticResource SecondaryButton}" Padding="16,7" Command="{Binding RemoveCommand}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding PanelText}" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PanelText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- every macro on this profile -->
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="MACROS ON THIS PROFILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedText}"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding KeyName}" FontWeight="SemiBold" Width="90"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ACTUATION -->
                <TabItem Header="Actuation">
                    <Grid DataContext="{Binding ActuationTab}" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding LastSentText}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                            <CheckBox Content="Also re-send this profile's last live-sent table when I switch to it (not needed for tables saved to the profile)" IsChecked="{Binding ReapplyOnSwitch, Mode=TwoWay}" FontSize="12" Margin="0,6,0,0"
                                      ToolTip="A table you save with Save to Config N stays with that profile on the keyboard. This only matters for tables you sent live (Send to keyboard) without saving."/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,12" HorizontalAlignment="Left">
                            <local:KeyboardView Rows="{Binding Rows}" KeyCommand="{Binding ToggleKeyCommand}"/>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding GlobalText}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="All keys" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="{Binding MaxIndex}" Value="{Binding GlobalIndex}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0"/>
                                        <DockPanel Margin="0,0,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="4.0 mm (deepest)" Style="{StaticResource MutedText}" FontSize="12"/>
                                            <TextBlock Text="0.1 mm (lightest)" Style="{StaticResource MutedText}" FontSize="12"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="Selected keys" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"
                                                   Text="Click keys above to pick them (solid = picked, outlined = has its own value)."/>
                                        <Slider Minimum="0" Maximum="{Binding MaxIndex}" Value="{Binding SelectionIndex}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,8"/>
                                        <WrapPanel>
                                            <Button Content="{Binding SetSelectedText}" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,6" Command="{Binding SetSelectedCommand}"/>
                                            <Button Content="Back to the all-keys value" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,6" Command="{Binding ClearSelectedCommand}"/>
                                            <Button Content="Select all" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,6" Command="{Binding SelectAllCommand}"/>
                                            <Button Content="Select none" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,6" Command="{Binding SelectNoneCommand}"/>
                                            <Button Content="Clear all individual values" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,0,6" Command="{Binding ClearAllOverridesCommand}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Back to what was last sent" Style="{StaticResource SecondaryButton}" Command="{Binding RevertCommand}" Margin="0,0,8,0"/>
                                    <Button Content="{Binding SaveToProfileText}" Style="{StaticResource SecondaryButton}" Command="{Binding SaveToProfileCommand}" Margin="0,0,8,0"
                                            ToolTip="Sends the table live AND writes it into this profile on the keyboard, the way GG's Save does. Takes about 15 seconds and asks you to confirm."/>
                                    <Button Content="Send to keyboard" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                                            ToolTip="Sends the table to the keyboard right now. It is not written into the profile (use Save to Config N for that)."/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StateText}" FontSize="12.5" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUnsentChanges}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                            <!-- SOCD -->
                <TabItem Header="SOCD">
                    <Grid DataContext="{Binding SocdTab}" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button DockPanel.Dock="Left" Content="Load from keyboard" Style="{StaticResource PrimaryButton}" Padding="14,6" Command="{Binding LoadCommand}"/>
                            <TextBlock Text="{Binding LoadedText}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="22,18" IsEnabled="{Binding HasLoaded}" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Content="SOCD on" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="14"/>
                                    <TextBlock Text="SOCD pairs" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,14" MaxWidth="900" HorizontalAlignment="Left"
                                           Text="When both keys of a pair are held at once, the keyboard reports just one of them, so opposite directions (A and D, W and S) can never cancel each other. Last input priority: the key you pressed most recently wins. Key 1 priority: key 1 wins whenever both are held. Key 2 priority: key 2 wins. Up to 5 pairs, and a key can only be in one pair. The setting is stored in the profile, so this edits the profile named at the top right."/>

                                <Grid Margin="30,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="230"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="KEY 1" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Grid.Column="1" Text="KEY 2" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Grid.Column="2" Text="WHEN BOTH ARE HELD" Style="{StaticResource SectionLabel}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Pairs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Number}" Width="20" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.KeyChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding Key1, Mode=TwoWay}" Width="140" Margin="0,0,10,0" Padding="8,3"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.KeyChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding Key2, Mode=TwoWay}" Width="140" Margin="0,0,10,0" Padding="8,3"/>
                                                    <ComboBox ItemsSource="{Binding DataContext.BehaviorChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding Behavior, Mode=TwoWay}" Width="220" Margin="0,0,14,0" Padding="8,3"/>
                                                    <Button Content="Remove pair" Style="{StaticResource SecondaryButton}" Padding="10,3"
                                                            Command="{Binding DataContext.RemovePairCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Add pair" Style="{StaticResource SecondaryButton}" Padding="12,5" HorizontalAlignment="Left" Margin="0,4,0,14" Command="{Binding AddPairCommand}"/>

                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12"/>
                                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="18" Margin="0,3,0,10" FontSize="12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save SOCD to keyboard..." Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"/>
                                    <TextBlock Text="You will see exactly what will be written and confirm first." Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0" Padding="12,5" CornerRadius="8" BorderThickness="1"
                    Background="{StaticResource ActiveProfileBrush}" BorderBrush="{StaticResource AccentEdgeBrush}"
                    ToolTip="The Macros and SOCD tabs read and write this profile. Double-click another profile on the left to edit that one.">
                <TextBlock Text="{Binding EditingText}" FontSize="13" FontWeight="SemiBold"/>
            </Border>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Padding="16,9" CornerRadius="12" BorderThickness="1"
                    MaxWidth="620" Cursor="Hand" Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}"
                    ToolTip="Click to dismiss">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding DismissToastCommand}"/></Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F2143D2A"/>
                        <Setter Property="BorderBrush" Value="#FF3DBE7A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastOk}" Value="False">
                                <Setter Property="Background" Value="#F2451A1A"/>
                                <Setter Property="BorderBrush" Value="#FFE0605A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ToastText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FFF4F4F2"/>
            </Border>
            </Grid>
        </Grid>

        <!-- status / progress / log -->
        <Border Grid.Row="3" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel>
                <DockPanel>
                    <ToggleButton x:Name="DetailsToggle" DockPanel.Dock="Right" Content="Details" Style="{StaticResource LinkToggle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar Height="4" Margin="0,8,0,0" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="{Binding ProgressMax, Mode=OneWay}"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}" BorderThickness="0"
                             IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="110" Margin="0,8,0,0" FontSize="12"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
