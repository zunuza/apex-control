<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ApexControl.Core</RootNamespace>
    <AssemblyName>ApexControl.Core</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- HidSharp: Apache-2.0-licensed, pure managed HID access. No accounts, no phoning home. -->
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

  <!-- Release builds carry no debug info, so no build-machine paths (which include the Windows user name) end up in the exe. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=src</PathMap>
  </PropertyGroup>

</Project>
